+/*
+ * report-cpu-resets (experiment, diagnostic -- see the experiments README).
+ * Who asked for which core's reset, and where both cores were then. A core
+ * that is running may report a pc up to one translation block old.
+ */
+static void report_core_reset(const char *which)
+{
+    CPUState *c0 = qemu_get_cpu(0), *c1 = qemu_get_cpu(1);
+
+    qemu_log_mask(LOG_UNIMP, "cpu-reset: %s requested by core %d at %" PRId64
+                  " ns; core0 pc %08" PRIx64 "%s, core1 pc %08" PRIx64 "%s\n",
+                  which, current_cpu ? current_cpu->cpu_index : -1,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                  c0 ? (uint64_t)c0->cc->get_pc(c0) : 0,
+                  c0 && c0->halted ? " (halted)" : "",
+                  c1 ? (uint64_t)c1->cc->get_pc(c1) : 0,
+                  c1 && c1->halted ? " (halted)" : "");
+}
+
 static uint64_t esp32s3_rtc_cntl_read(void *opaque, hwaddr addr, unsigned int size)
 {
